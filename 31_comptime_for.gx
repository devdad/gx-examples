// 31_comptime_for.gx
//
// #for runs the loop while compiling and stamps the body out once per
// iteration, with the index as a literal. No counter, no branch in the
// output; the nested version below lands as nine plain statements
// before the backend ever sees them. In C this job goes to X-macros or
// an external codegen script, both of which hide what the output
// actually is. GX's position is that generating repetitive code is a
// job for the language itself, written in the language itself.

fn main() {
    // Basic #for - unrolls to 5 print calls
    print("=== Compile-Time Loop Unrolling (#for) ===");

    #for (i=0:5) {
        print("iteration {i}");
    }

    // #for with expressions using the loop variable
    var sum:i32 = 0;
    #for (i=1:6) {
        sum += i * i;
    }
    print("sum of squares 1..5 = {sum}");

    // Nested #for - generates 3x3 = 9 iterations
    #for (row=0:3) {
        #for (col=0:3) {
            var val:i32 = row * 3 + col;
            print("  ({row},{col}) = {val}");
        }
    }

    // #for with const bounds
    const N = 4;
    #for (i=0:N) {
        print("channel {i}");
    }

    print("Done!");
}
