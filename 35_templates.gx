// 35_templates.gx
//
// #type T declares a type parameter. Every concrete use like Pair<i32>
// stamps out a real struct at compile time, so the C output holds
// struct Pair_i32 with two int32_t fields, exactly what you would have
// written by hand. That mechanism, substitution and nothing else, is
// the whole feature, and the restraint is deliberate.
//
// C++ went the other way. Its templates grew into a second language,
// with specialization, overload resolution games, and error messages
// measured in pages, and most of that machinery exists to smuggle
// computation into the type system. GX already has a compile-time
// language, the # system, so templates do not need to be one. When you
// want logic at compile time you write #if, #fn, or #for. #type only
// fills in types.
//
// What that buys you: generics with zero runtime cost, no boxing and
// no vtables. Every instance is an ordinary named C struct, so it can
// cross the C boundary like anything else, and you can open the
// generated C and read what you got. T is unconstrained, so code that
// does not fit the type fails at the use that stamped it, the same
// trade C++ lived with before concepts. I keep it because it keeps
// the feature small.

// The smallest possible template: one type parameter, one field. Box<i32>
// becomes struct Box_i32 { int32_t value; }, nothing more.
#type T
struct Box {
    value: T
}

#type T
struct Pair {
    first: T
    second: T
}

fn main() {
    print("=== Compile-Time Templates ===\n");

    // Box in its simplest form: same code, three concrete structs.
    var bi: Box<i32>;
    bi.value = 7;
    var bf: Box<f32>;
    bf.value = 3.14;
    var bs: Box<str>;
    bs.value = "boxed";
    print("Box<i32>: {bi.value.str()}\n");
    print("Box<f32>: {bf.value.str()}\n");
    print("Box<str>: {bs.value.str()}\n");

    // Pair<i32> - generates struct Pair_i32 { int32_t first; int32_t second; }
    var pi: Pair<i32>;
    pi.first = 10;
    pi.second = 20;
    print("Pair<i32>: ({pi.first.str()}, {pi.second.str()})\n");

    // Pair<i64> - generates struct Pair_i64 { int64_t first; int64_t second; }
    var pl: Pair<i64>;
    pl.first = 100;
    pl.second = 200;
    print("Pair<i64>: ({pl.first.str()}, {pl.second.str()})\n");

    var pf: Pair<f32>;
    pf.first = 100.32;
    pf.second = 200.32;
    print("Pair<f32>: ({pf.first.str()}, {pf.second.str()})\n");

    // Non-scalar type arguments work the same way.
    var ps: Pair<str>;
    ps.first = "Afan";
    ps.second = "Olovcic";
    print("Pair<str>: ({ps.first.str()}, {ps.second.str()})\n");
    {
        var ps:Pair< str >;
        ps.first = "Sanela";
        ps.second = "Gluhovic";
        print("Pair<str>: ({ps.first.str()}, {ps.second.str()})\n");
    }
    print("Done!\n");
}
