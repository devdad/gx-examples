// 29_comptime_if.gx
//
// #if is decided while compiling, and the losing branch never reaches
// the output. This is GX's answer to the C preprocessor, and the
// decision behind it matters: the preprocessor is a second language
// living on top of the first, one that cannot see types, consts, or
// scopes, which is exactly how #ifdef soup happens. In GX the condition
// is a normal expression over your own consts and build facts like @os,
// @debug, and @opt. One language, deciding earlier.

// Platform detection with @os
#if (@os == "windows") {
    const PLATFORM = "Windows";
}
#else {
    const PLATFORM = "Other";
}

fn main() {
    print("Platform: {PLATFORM}");

    // Statement-level #if with @os
    #if (@os == "windows") {
        print("Running on Windows");
    }
    #else {
        print("Running on non-Windows");
    }

    // #if with user const
    const ENABLE_FEATURE = true;
    #if (ENABLE_FEATURE) {
        print("Feature enabled");
    }

    // @debug check (false unless --debug flag)
    #if (@debug) {
        print("Debug mode ON");
    }
    #else {
        print("Debug mode OFF");
    }

    // @opt level check
    #if (@opt > 0) {
        print("Optimized build");
    }
    #else {
        print("Unoptimized build");
    }

    print("Done!");
}
