// 33_reflection.gx
//
// Compile-time reflection. @fields, @field, @field_type and friends
// answer questions about your types, and #for turns the answers into
// code. The decision here: the compiler already knows every field and
// every member, so the language should let you ask while it still
// knows. Runtime reflection would mean type tables carried in the
// binary and lookups paid on every use, which is how languages grow
// invisible weight. This way the walk happens at build time and ships
// as zero bytes of type information.
//
// The payoff is code that cannot drift. color_name below is the
// enum-to-string function every C codebase maintains by hand in a
// switch, except here the compiler writes it from the enum itself.
// Add a member and the function already knows it.

struct Point {
    x: f32
    y: f32
    z: f32
}

struct Node {
    value: i32
    next: *Node
}

enum Color { Red  Green  Blue }

// Generated enum-to-name: #for unrolls one comparison per member, and
// @member drops the name in as a string literal. Plain branches in the
// output, no table, no maintenance.
fn color_name:str(c: Color) {
    #for (i=0:@members(Color)) {
        if ((i32)c == i) { return "{@member(Color, i)}"; }
    }
    return "?";
}

fn main() {
    print("=== Compile-Time Reflection ===\n");

    // --- Struct field reflection ---
    print("Point has {@fields(Point)} fields:\n");
    #for (i=0:@fields(Point)) {
        print("  {@field(Point, i)}: {@field_type(Point, i)}\n");
    }

    // --- Field detail intrinsics ---
    print("Node has {@fields(Node)} fields:");
    #for (i=0:@fields(Node)) {
        print("  {@field(Node, i)}: ptr={@field_is_ptr(Node, i)}\n");
    }

    // --- Enum member reflection ---
    print("Color has {@members(Color)} members:\n");
    #for (i=0:@members(Color)) {
        print("  {@member(Color, i)}");
    }

    // --- The generated function in use ---
    var picked: Color = Green;
    print("picked = {color_name(picked)}\n");
    print("by value = {color_name(Blue)}\n");

    // --- Type meta ---
    print("@type_kind(Point) = {@type_kind(Point)}\n");
    print("@type_kind(Color) = {@type_kind(Color)}\n");
    print("@type_name(Point) = {@type_name(Point)}\n");

    // Note: Function reflection (@params, @param, @return_type) works
    // but requires multi-file module setup (single-file function
    // declarations have a pre-existing resolver limitation)

    print("Done!");
}
