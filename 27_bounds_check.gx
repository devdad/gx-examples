// 27_bounds_check.gx
//
// Bounds checking happens as early as the compiler can manage. A
// constant index into a fixed-size array is rejected at compile time,
// arr[10] on a three element array never builds. A slice is different,
// its length is runtime information, so slice indexing is checked as
// the program runs. That is what this file shows: it goes out of range
// through a slice on purpose, so expect it to die at s[10]. The
// runtime checks stay in at every -O level. The --unchecked flag
// strips them, for the rare program that has measured them and cannot
// afford them.

fn main() {
    // Fixed array bounds check
    var arr: i32[3] = {10, 20, 30};
    print("arr[0] = {arr[0]}\n");
    print("arr[2] = {arr[2]}\n");
    print("arr.len = {arr.len}\n");

    // Slice bounds check
    var s: []i32 = arr;
    print("s[0] = {s[0]}\n");
    print("s[2] = {s[2]}\n");

    // This will PANIC:
    print("About to access s[10]...\n");
    print("s[10] = {s[10]}\n");
    print("This should never print!\n");
}
