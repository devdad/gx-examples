// 27_bounds_check.gx
//
// Array and slice indexing is bounds-checked in debug builds, the
// default. Go out of range and the program panics instead of quietly
// corrupting memory. This file does it on purpose, so expect it to die
// at s[10]. Build with -O1 or higher and the checks are gone, release
// code pays nothing for them.

fn main() {
    // Fixed array bounds check
    var arr: i32[3] = {10, 20, 30};
    print("arr[0] = {arr[0]}\n");
    print("arr[2] = {arr[2]}\n");
    print("arr.len = {arr.len}\n");

    // Slice bounds check
    var s: []i32 = arr;
    print("s[0] = {s[0]}\n");
    print("s[2] = {s[2]}\n");

    // This will PANIC:
    print("About to access s[10]...\n");
    print("s[10] = {s[10]}\n");
    print("This should never print!\n");
}
