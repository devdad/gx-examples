// 04_control_flow.gx
//
// if, elif, else, while, and the for loop in its three forms: a range,
// a for-each over an array, and a for-each filtered with where.
//
// where and collect are the two things here you will not find in C.
// I took them from MAXScript, where they make everyday array work
// short and readable, and kept that while making them compile to the
// plain loop you would have written by hand. where filters values as
// the loop runs, no allocation, no cost. collect turns a loop into an
// array builder: it keeps every value that passes the filter and hands
// you a new array. That is the one construct in this file that touches
// the heap, and the array is yours, so you free it when you are done.
// There is no garbage collector coming to do it for you.

fn main() {
    // --- If / elif / else ---
    var score:i32 = 75;
    var x:i32 = 10;

    print("Helloo\n");
    if (score >= 90) {
        print("Grade: A\n");
    } elif (score >= 80) {
        print("Grade: B\n");
    } elif (score >= 70) {
        print("Grade: C\n");
    } else {
        print("Grade: F\n");
    }

    // --- While loop ---
    var count:i32 = 0;
    while (count < 5) {
        print("count={count}\n");
        count = count + 1;
    }

    // --- For-range (inclusive) ---
    print("\nFor-range 1 to 5:\n");
    for (i = 1:5) {
        print("  i={i}\n");
    }

    // --- For-each over array ---
    print("\nFor-each:\n");
    var arr:i32[5] = {10, 20, 30, 40, 50};
    for (var x in arr) {
        print("  x={x}\n");
    }

    // --- For-each with where filter ---
    print("\nFiltered (even only):\n");
    var nums:i32[8] = {1, 2, 3, 4, 5, 6, 7, 8};
    for (var n in nums) where (n % 2 == 0) {
        print("  even={n}\n");
    }

    // --- Collect: build an array from a loop ---
    // One line replaces the usual count-allocate-fill dance.
    var evens = for (n in nums) where (n % 2 == 0) collect n;
    print("\nCollected evens ({evens.len()}):");
    for (var e in evens) {
        print(" {e}");
    }

    print("\n");

    // The collected expression can be any transform, not just the value.
    var doubled = for (n in nums) where (n <= 4) collect n * 10;
    print("Doubled small ({doubled.len()}):");
    for (var d in doubled) {
        print(" {d}");
    }
    print("\n");

    // collect allocated these, so they are ours to release.
    evens.free();
    doubled.free();
}
