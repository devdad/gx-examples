// 05_arrays.gx
//
// Fixed-size arrays. The layout is exactly C: five i32s are twenty
// contiguous bytes, no header, no hidden field. The difference is that
// the compiler knows the size. It is part of the type, .len hands it to
// you, and slicing gives a pointer plus length view instead of a bare
// pointer that forgot how long it is.
//
// A word on safety, because I want to be precise about what you get.
// An index the compiler can prove wrong does not compile at all:
// scores[9] on a five element array is an error in every build mode,
// since both the index and the size are sitting right there. For
// indexes only known at runtime, a default build checks every access
// and panics with the index and the length instead of reading whatever
// sits past the array. Build with -O1 or higher and those runtime
// checks are stripped, so a release build trusts your computed indexes
// exactly the way C does. GX also has raw pointers, and nothing checks
// those. Safer to develop in than C, then. Not a memory-safe language,
// and I will not pretend otherwise.

fn main() {
    // Fixed-size array with initializer
    var scores:i32[5] = {95, 82, 74, 88, 91};

    // A slice is a view into the array, no copy. Ranges are inclusive,
    // so 0:3 is four elements.
    var win:[]i32 = scores[0:3];

    print("Winners:\n");
    for (var s in win) {
        print(" win {s}\n");
    }

    var colors:f32[3] = {1.0, 0.0, 0.0};
    print("\nRGB: {colors[0]}, {colors[1]}, {colors[2]}\n");

    // Modify by index
    scores[0] = 100;
    print("\nUpdated first score: {scores[0]}\n");

    // scores[9] = 0;   // try it: does not compile, index 9 out of bounds (len 5)

    // .len is known at compile time, no sentinel, no separate size variable
    print("\nAll {scores.len} scores after update:\n");
    for (i = 0:scores.len-1) {
        print("  scores[{i}] = {scores[i]}\n");
    }
}
