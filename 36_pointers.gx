// 36_pointers.gx
//
// Pointers here are C pointers, and they behave like it. Take an address,
// dereference, add an offset, subtract two of them, index. None of it is
// checked. The arithmetic in this file stays inside a real array, because
// stepping past one object's storage is undefined behavior in GX exactly
// as it is in C.
//
// Honest advice: this is the least safe corner of the language, and you
// need it less often than you think. Pointers are in GX because GX
// speaks the C ABI and C libraries hand you pointers all day. Use them
// at that boundary, and for handing out a single value to be written
// through. The moment you are walking a run of elements, take a slice
// instead. It knows its length, indexing it is checked, and it costs
// the same. Odin went as far as dropping pointer arithmetic from the
// language and leaning on slices. GX keeps it for the C boundary, but
// pointer arithmetic in everyday GX code usually means a slice was the
// right tool.

fn main() {
    print("=== Pointer Arithmetic ===");

    // Basic dereference
    var x:i32 = 42;
    var p:*i32 = &x;
    print("*p = {(*p).str()}");
    *p = 99;
    print("after *p=99: x = {x.str()}#\n");

    // Use an actual array so pointer arithmetic has defined semantics -
    // reading *(pa + N) for individually-declared `var a/b/c` would be
    // UB past the end of `a`'s storage.
    var arr:i32[3]
    arr[0] = 311
    arr[1] = 20
    arr[2] = 30

    var pa:*i32 = &arr[0];
    // Test pointer + int type
    var pb:*i32 = pa + 1;
    print("pa+1 deref = {(*pb).str()}");

    // Pointer difference
    var diff:i64 = pb - pa;
    print("pb - pa = {diff.str()}");

    // Pointer indexing
    print("pa[0] = {pa[0].str()}");
    print("pa[2] = {pa[2].str()}");

    print("Done!");
}
